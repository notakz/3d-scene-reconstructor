    def reconstruct_from_single_image(self, image_path, output_dir='output'):
        """
        Główna funkcja rekonstrukcji 3D sceny z pojedynczego zdjęcia
        
        Pipeline:
        1. Estymacja głębi (monocular depth estimation)
        2. Segmentacja obiektów
        3. Generowanie multi-view images z zachowaniem spójności
        4. Budowa 3D Gaussian Splatting representation
        5. Export do interaktywnego viewera
        """
        
        Path(output_dir).mkdir(exist_ok=True)
        
        print(f"🖼️  Przetwarzanie obrazu: {image_path}")
        
        # STAGE 1: Global Scaffold - budowa globalnego szkieletu 3D
        print("\n=== STAGE 1: Budowa globalnego szkieletu 3D ===")
        scaffold_data = self._build_global_scaffold(image_path)
        
        # STAGE 2: Multi-view Consistent Sampling
        print("\n=== STAGE 2: Generowanie widoków z zachowaniem spójności ===")
        multiview_data = self._generate_multiview_consistent(
            scaffold_data, 
            num_views=16
        )
        
        # STAGE 3: 3D Gaussian Splatting
        print("\n=== STAGE 3: Budowa 3D Gaussian Field ===")
        gaussian_field = self._build_gaussian_splatting(multiview_data)
        
        # STAGE 4: Export do interaktywnego viewera
        print("\n=== STAGE 4: Export do interaktywnego viewera ===")
        self._export_interactive_scene(gaussian_field, output_dir)
        
        print(f"\n✅ Rekonstrukcja zakończona! Pliki w: {output_dir}")
        
        return gaussian_field
        
    def _build_global_scaffold(self, image_path):
        """
        Budowa globalnego szkieletu sceny poprzez:
        - Outpainting (rozszerzenie granic obrazu)
        - Depth estimation (estymacja mapy głębi)
        - Camera pose estimation
        """
        
        img = Image.open(image_path)
        
        # 1. Depth Estimation - używamy Depth-Pro dla metrycznej głębi
        print("  📊 Estymacja głębi...")
        depth_map = self._estimate_depth(img)
        
        # 2. Outpainting - rozszerzenie obrazu dla pełniejszego kontekstu
        print("  🎨 Outpainting granic...")
        outpainted = self._outpaint_image(img)
        
        # 3. Sky Segmentation - wykrycie nieba dla lepszej rekonstrukcji
        print("  ☁️  Segmentacja nieba...")
        sky_mask = self._segment_sky(outpainted)
        
        # 4. Camera Pose Estimation
        print("  📷 Estymacja pozycji kamery...")
        camera_params = self._estimate_camera_pose(depth_map)
        
        scaffold_data = {
            'original_image': img,
            'outpainted_image': outpainted,
            'depth_map': depth_map,
            'sky_mask': sky_mask,
            'camera_params': camera_params
        }
        
        return scaffold_data
        
    def _estimate_depth(self, image):
        """
        Monocular depth estimation używając CNN/Transformer
        Zwraca znormalizowaną mapę głębi gdzie większe wartości = większa odległość
        """
        
        # Symulacja depth estimation (w rzeczywistości używamy Depth-Pro)
        img_array = np.array(image)
        h, w = img_array.shape[:2]
        
        # Placeholder - w rzeczywistości wykorzystujemy pretrenowany model
        depth = np.random.rand(h, w).astype(np.float32)
        
        return depth
        
    def _outpaint_image(self, image):
        """
        Rozszerzenie granic obrazu używając Fooocus inpainting
        dla lepszego kontekstu przestrzennego
        """
        
        # W rzeczywistości używamy Fooocus
        return image
        
    def _segment_sky(self, image):
        """
        Segmentacja nieba używając OneFormer
        """
        
        img_array = np.array(image)
        sky_mask = np.zeros(img_array.shape[:2], dtype=np.uint8)
        
        return sky_mask
        
    def _estimate_camera_pose(self, depth_map):
        """
        Estymacja parametrów kamery z mapy głębi
        """
        
        # Domyślne parametry kamery
        camera_params = {
            'fov': 60.0,
            'near': 0.1,
            'far': 100.0,
            'position': [0, 0, 5],
            'target': [0, 0, 0]
        }
        
        return camera_params
        
    def _generate_multiview_consistent(self, scaffold_data, num_views=16):
        """
        Generowanie wielokrotnych widoków z zachowaniem spójności
        używając Multi-view Consistency Sampling (MCS)
        
        MCS wprowadza ograniczenia spójności wielowidokowej
        w procesie reverse sampling modeli dyfuzyjnych
        """
        
        print(f"  🔄 Generowanie {num_views} spójnych widoków...")
        
        multiview_images = []
        multiview_depths = []
        camera_poses = []
        
        # Generowanie kamer wokół sceny
        for i in range(num_views):
            angle = (i / num_views) * 360
            
            # Kamera na okręgu wokół sceny
            radius = 5.0
            x = radius * np.cos(np.radians(angle))
            z = radius * np.sin(np.radians(angle))
            
            camera_pose = {
                'position': [x, 1.5, z],
                'target': [0, 0, 0],
                'angle': angle
            }
            
            camera_poses.append(camera_pose)
            
            # W rzeczywistości używamy diffusion model do generowania widoku
            # z ograniczeniami spójności wielowidokowej
            multiview_images.append(scaffold_data['original_image'])
            multiview_depths.append(scaffold_data['depth_map'])
        
        return {
            'images': multiview_images,
            'depths': multiview_depths,
            'cameras': camera_poses
        }
        
    def _build_gaussian_splatting(self, multiview_data):
        """
        Budowa 3D Gaussian Splatting representation
        dla szybkiego renderowania w czasie rzeczywistym
        
        Gaussian Splatting pozwala na:
        - Renderowanie w czasie rzeczywistym (>60 FPS)
        - Omnidirectional viewing
        - Wysoką jakość wizualną
        """
        
        print("  🌟 Budowa Gaussian Splatting...")
        
        # Struktura danych dla 3D Gaussians
        gaussians = {
            'positions': [],      # pozycje xyz
            'rotations': [],      # kwaterniony rotacji
            'scales': [],         # skale xyz
            'opacities': [],      # przezroczystość
            'colors': [],         # kolory RGB (lub SH coefficients)
        }
        
        # Dla każdego widoku, ekstrahujemy punkty 3D
        for i, (img, depth, cam) in enumerate(zip(
            multiview_data['images'],
            multiview_data['depths'],
            multiview_data['cameras']
        )):
            
            # Konwersja depth map na punkty 3D
            points_3d = self._depth_to_3d_points(depth, cam)
            colors = self._extract_colors(img, depth)
            
            # Dodanie Gaussians
            for point, color in zip(points_3d, colors):
                gaussians['positions'].append(point)
                gaussians['rotations'].append([0, 0, 0, 1])  # identity quaternion
                gaussians['scales'].append([0.1, 0.1, 0.1])
                gaussians['opacities'].append(1.0)
                gaussians['colors'].append(color)
        
        # Konwersja do tensors
        for key in gaussians:
            gaussians[key] = np.array(gaussians[key])
        
        return gaussians
        
    def _depth_to_3d_points(self, depth_map, camera):
        """
        Konwersja mapy głębi na punkty 3D w przestrzeni świata
        """
        
        h, w = depth_map.shape
        points = []
        
        # Sampling co kilka pikseli dla wydajności
        step = 4
        
        for y in range(0, h, step):
            for x in range(0, w, step):
                
                d = depth_map[y, x]
                
                # Konwersja z screen space do world space
                # (uproszczone - rzeczywista implementacja używa macierzy projekcji)
                wx = (x / w - 0.5) * d * 2
                wy = (y / h - 0.5) * d * 2
                wz = -d
                
                points.append([wx, wy, wz])
        
        return np.array(points)
        
    def _extract_colors(self, image, depth_map):
        """
        Ekstrahowanie kolorów z obrazu odpowiadających punktom głębi
        """
        
        img_array = np.array(image)
        h, w = depth_map.shape
        colors = []
        
        step = 4
        
        for y in range(0, h, step):
            for x in range(0, w, step):
                
                if y < img_array.shape[0] and x < img_array.shape[1]:
                    color = img_array[y, x] / 255.0
                    colors.append(color[:3] if len(color) > 3 else color)
                else:
                    colors.append([0.5, 0.5, 0.5])
        
        return np.array(colors)
        
    def _export_interactive_scene(self, gaussian_field, output_dir):
        """
        Export sceny do formatu PLY dla Gaussian Splatting
        oraz generowanie interaktywnego HTML viewera
        """
        
        # 1. Export Gaussian Splatting do PLY
        ply_path = os.path.join(output_dir, 'scene.ply')
        self._save_gaussian_ply(gaussian_field, ply_path)
        print(f"  💾 Zapisano Gaussian Field: {ply_path}")
        
        # 2. Generowanie interaktywnego viewera HTML + Three.js
        html_path = os.path.join(output_dir, 'viewer.html')
        self._generate_threejs_viewer(html_path)
        print(f"  🌐 Wygenerowano viewer: {html_path}")
        
        # 3. Export danych sceny do JSON
        json_path = os.path.join(output_dir, 'scene_data.json')
        self._save_scene_json(gaussian_field, json_path)
        print(f"  📄 Zapisano metadata: {json_path}")
        
    def _save_gaussian_ply(self, gaussians, filepath):
        """
        Zapis Gaussian Splatting do formatu PLY
        kompatybilnego z SuperSplat i innymi viewerami
        """
        
        positions = gaussians['positions']
        colors = gaussians['colors']
        
        # Header PLY
        header = f"""ply
format binary_little_endian 1.0
element vertex {len(positions)}
property float x
property float y
property float z
property uchar red
property uchar green
property uchar blue
end_header
"""
        
        with open(filepath, 'wb') as f:
            f.write(header.encode('ascii'))
            
            # Zapis vertices
            for pos, col in zip(positions, colors):
                # Position (float32)
                f.write(pos.astype(np.float32).tobytes())
                # Color (uint8)
                color_bytes = (col * 255).astype(np.uint8).tobytes()
                f.write(color_bytes)
        
    def _save_scene_json(self, gaussians, filepath):
        """
        Zapis metadanych sceny do JSON
        """
        
        scene_data = {
            'num_gaussians': len(gaussians['positions']),
            'bounds': {
                'min': gaussians['positions'].min(axis=0).tolist(),
                'max': gaussians['positions'].max(axis=0).tolist()
            },
            'camera_defaults': {
                'fov': 60,
                'near': 0.1,
                'far': 100.0,
                'position': [0, 2, 5],
                'target': [0, 0, 0]
            }
        }
        
        with open(filepath, 'w') as f:
            json.dump(scene_data, f, indent=2)
    
