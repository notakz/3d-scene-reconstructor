            renderer.setPixelRatio(window.devicePixelRatio);
            document.getElementById('canvas-container').appendChild(renderer.domElement);

            // Orbit Controls
            controls = new OrbitControls(camera, renderer.domElement);
            controls.enableDamping = true;
            controls.dampingFactor = 0.05;
            controls.minDistance = 1;
            controls.maxDistance = 50;

            // Światła
            const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
            scene.add(ambientLight);

            const directionalLight = new THREE.DirectionalLight(0xffffff, 0.8);
            directionalLight.position.set(5, 10, 7);
            scene.add(directionalLight);

            // Grid helper
            const gridHelper = new THREE.GridHelper(20, 20, 0x444444, 0x222222);
            scene.add(gridHelper);

            // Axes helper
            const axesHelper = new THREE.AxesHelper(5);
            scene.add(axesHelper);

            // Ładowanie PLY (Gaussian Splatting)
            loadScene();

            // Event listeners
            window.addEventListener('resize', onWindowResize);
            window.addEventListener('keydown', (e) => keys[e.key.toLowerCase()] = true);
            window.addEventListener('keyup', (e) => keys[e.key.toLowerCase()] = false);
        }

        function loadScene() {
            const loader = new PLYLoader();
            
            // Najpierw ładujemy prostą geometrię jako placeholder
            // W rzeczywistej aplikacji tutaj ładowałby się plik scene.ply
            createPlaceholderScene();
        }

        function createPlaceholderScene() {
            // Tworzenie przykładowej sceny jako placeholder
            const geometry = new THREE.BufferGeometry();
            const positions = [];
            const colors = [];
            
            // Generowanie chmury punktów reprezentującej pokój
            for (let i = 0; i < 50000; i++) {
                // Losowe punkty w przestrzeni pokoju
                const x = (Math.random() - 0.5) * 10;
                const y = Math.random() * 5;
                const z = (Math.random() - 0.5) * 10;
                
                positions.push(x, y, z);
                
                // Kolory bazowane na pozycji
                colors.push(
                    Math.random() * 0.5 + 0.5,
                    Math.random() * 0.5 + 0.5,
                    Math.random() * 0.5 + 0.5
                );
            }
            
            geometry.setAttribute('position', 
                new THREE.Float32BufferAttribute(positions, 3));
            geometry.setAttribute('color', 
                new THREE.Float32BufferAttribute(colors, 3));
            
            pointsMaterial = new THREE.PointsMaterial({
                size: 0.05,
                vertexColors: true,
                sizeAttenuation: true
            });
            
            sceneObject = new THREE.Points(geometry, pointsMaterial);
            scene.add(sceneObject);
        }

        function animate() {
            requestAnimationFrame(animate);
            
            // FPS counter
            frames++;
            const time = performance.now();
            if (time >= lastTime + 1000) {
                fps = Math.round((frames * 1000) / (time - lastTime));
                document.getElementById('fps').textContent = `FPS: ${fps}`;
                frames = 0;
                lastTime = time;
            }
            
            // FPS mode movement
            if (cameraMode === 'fps') {
                handleFPSMovement();
            }
            
            controls.update();
            renderer.render(scene, camera);
        }

        function handleFPSMovement() {
            const direction = new THREE.Vector3();
            const right = new THREE.Vector3();
            
            camera.getWorldDirection(direction);
            right.crossVectors(camera.up, direction).normalize();
            
            if (keys['w']) camera.position.addScaledVector(direction, -moveSpeed);
            if (keys['s']) camera.position.addScaledVector(direction, moveSpeed);
            if (keys['a']) camera.position.addScaledVector(right, moveSpeed);
            if (keys['d']) camera.position.addScaledVector(right, -moveSpeed);
            if (keys['q']) camera.position.y += moveSpeed;
            if (keys['e']) camera.position.y -= moveSpeed;
        }

        window.setCameraMode = function(mode) {
            cameraMode = mode;
            
            if (mode === 'orbit') {
                controls.enabled = true;
            } else if (mode === 'fps') {
                controls.enabled = false;
            } else if (mode === 'top') {
                camera.position.set(0, 10, 0);
                camera.lookAt(0, 0, 0);
            }
        }

        window.setView = function(view) {
            const distance = 8;
            
            switch(view) {
                case 'front':
                    camera.position.set(0, 2, distance);
                    break;
                case 'side':
                    camera.position.set(distance, 2, 0);
                    break;
                case 'top':
                    camera.position.set(0, distance, 0);
                    break;
                case 'iso':
                    camera.position.set(distance, distance, distance);
                    break;
            }
            
            camera.lookAt(0, 0, 0);
            controls.target.set(0, 0, 0);
        }

        window.updateDepthScale = function(value) {
            depthScale = parseFloat(value);
            document.getElementById('depthValue').textContent = depthScale.toFixed(1);
            
            if (sceneObject) {
                sceneObject.scale.z = depthScale;
            }
        }

        window.updateFOV = function(value) {
            const fov = parseInt(value);
            document.getElementById('fovValue').textContent = fov;
            camera.fov = fov;
            camera.updateProjectionMatrix();
        }

        window.toggleWireframe = function() {
            if (sceneObject && sceneObject.material) {
                sceneObject.material.wireframe = !sceneObject.material.wireframe;
            }
        }

        window.togglePoints = function() {
            if (pointsMaterial) {
                pointsMaterial.size = pointsMaterial.size === 0.05 ? 0.1 : 0.05;
            }
        }

        window.resetCamera = function() {
            camera.position.set(0, 2, 5);
            camera.lookAt(0, 0, 0);
            controls.target.set(0, 0, 0);
